		{
			"name": "DeleteBook",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Validate status code is 200 or 204",
							"pm.test(\"Status code is 200 or 204\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
							"});",
							"",
							"// If response has a body, Content-Type should be JSON and structure should be as expected",
							"pm.test(\"If body is present, it is JSON and has expected structure\", function () {",
							"    const hasBody = pm.response.text() && pm.response.text().trim().length > 0;",
							"    if (!hasBody) {",
							"        pm.expect(pm.response.code).to.eql(204);",
							"        return;",
							"    }",
							"",
							"    pm.response.to.have.header(\"Content-Type\");",
							"    const contentType = pm.response.headers.get(\"Content-Type\");",
							"    pm.expect(contentType).to.include(\"application/json\");",
							"",
							"    let json;",
							"    try {",
							"        json = pm.response.json();",
							"    } catch (e) {",
							"        pm.expect.fail(\"Response body is not valid JSON\");",
							"    }",
							"",
							"    // Allow common delete response shapes: { success: true, message?: string, data?: any } or { message: string }",
							"    pm.test(\"JSON has acceptable delete response shape\", function () {",
							"        pm.expect(json).to.be.an(\"object\");",
							"        const hasSuccessBool = Object.prototype.hasOwnProperty.call(json, \"success\") && typeof json.success === \"boolean\";",
							"        const hasMessage = Object.prototype.hasOwnProperty.call(json, \"message\") && typeof json.message === \"string\";",
							"        const hasData = Object.prototype.hasOwnProperty.call(json, \"data\");",
							"        pm.expect(hasSuccessBool || hasMessage || hasData).to.eql(true);",
							"    });",
							"});",
							"",
							"// Warn if admin token variable is missing",
							"pm.test(\"Admin token variable present\", function () {",
							"    const token = pm.environment.get(\"admin\");",
							"    pm.expect(!!token, \"Environment variable 'admin' is missing. Set it to your Bearer token.\").to.eql(true);",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
